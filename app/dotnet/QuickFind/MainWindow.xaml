<Window x:Class="QuickFind.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:QuickFind.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="820" Width="1280"
        MinHeight="480" MinWidth="900"
        Background="{DynamicResource BgBrush}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="14"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        DragOver="Window_DragOver"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <views:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
    <views:GreaterThanOneToVisibilityConverter x:Key="GtOneVis"/>
    <views:ProgressWidthConverter x:Key="ProgWidth"/>
    <ContextMenu x:Key="IndexSettingsMenu">
      <MenuItem Header="Rebuild index" Command="{Binding RebuildCommand}"/>
      <Separator/>
      <MenuItem Header="Prefer NTFS file-table index" IsCheckable="True" IsChecked="{Binding PreferNtfs}"/>
      <MenuItem Header="Index USB / removable drives" IsCheckable="True" IsChecked="{Binding IndexRemovable}"/>
      <MenuItem Header="Index network drives" IsCheckable="True" IsChecked="{Binding IndexNetwork}"/>
    </ContextMenu>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
          Background="{DynamicResource BgBrush}">
  <Grid>
  <DockPanel>
    <!-- Custom title bar: brand + menus | theme + min/max/close -->
    <Border x:Name="TitleBar"
            DockPanel.Dock="Top"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
            Height="44"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Stretch">
          <Button Style="{DynamicResource ThemeToggleButton}"
                  Command="{Binding ToggleThemeCommand}"
                  ToolTip="{Binding ThemeTooltip}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock Text="{Binding ThemeGlyph}"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="14"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button Style="{DynamicResource CaptionButton}" Content="&#xE921;"
                  ToolTip="Minimize" Click="Minimize_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="MaxRestoreButton" Style="{DynamicResource CaptionButton}" Content="&#xE922;"
                  ToolTip="Maximize" Click="Maximize_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Style="{DynamicResource CaptionCloseButton}" Content="&#xE8BB;"
                  ToolTip="Close" Click="Close_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource AccentFillBrush}"
                  Margin="0,0,9,0" VerticalAlignment="Center"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Foreground="{DynamicResource OnAccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="QuickFind" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}"
                     VerticalAlignment="Center" Margin="0,0,14,0"/>
          <Menu VerticalAlignment="Center"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <MenuItem Header="_File">
              <MenuItem Header="Export…" Command="{Binding ExportCommand}"/>
              <Separator/>
              <MenuItem Header="Exit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit">
              <MenuItem Header="Copy full path" InputGestureText="Ctrl+C" Command="{Binding CopyFullNameCommand}"/>
              <MenuItem Header="Select all" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
              <MenuItem Header="Preview pane" IsCheckable="True" IsChecked="{Binding ShowPreview}"/>
              <MenuItem Header="Dark theme" IsCheckable="True" IsChecked="{Binding IsDark}"/>
              <MenuItem Header="Command palette" InputGestureText="Ctrl+K" Command="{Binding TogglePaletteCommand}"/>
              <Separator/>
              <MenuItem Header="Quick views">
                <MenuItem Header="Biggest files" Command="{Binding QuickViewCommand}" CommandParameter="biggest-files"/>
                <MenuItem Header="Biggest folders" Command="{Binding QuickViewCommand}" CommandParameter="biggest-folders"/>
                <MenuItem Header="Duplicate names" Command="{Binding QuickViewCommand}" CommandParameter="dupes"/>
                <MenuItem Header="Empty folders" Command="{Binding QuickViewCommand}" CommandParameter="empty"/>
                <MenuItem Header="Changed today" Command="{Binding QuickViewCommand}" CommandParameter="today"/>
              </MenuItem>
              <Separator/>
              <MenuItem Header="Accent">
                <MenuItem Header="Blue" Click="Accent_Click" Tag="blue"/>
                <MenuItem Header="Slate" Click="Accent_Click" Tag="slate"/>
                <MenuItem Header="Violet" Click="Accent_Click" Tag="violet"/>
                <MenuItem Header="Orange" Click="Accent_Click" Tag="orange"/>
                <MenuItem Header="Teal" Click="Accent_Click" Tag="teal"/>
              </MenuItem>
              <Separator/>
              <MenuItem Header="Path" IsCheckable="True" IsChecked="{Binding Columns.Path}" Click="ColumnMenu_Click"/>
              <MenuItem Header="Size" IsCheckable="True" IsChecked="{Binding Columns.Size}" Click="ColumnMenu_Click"/>
              <MenuItem Header="Extension" IsCheckable="True" IsChecked="{Binding Columns.Extension}" Click="ColumnMenu_Click"/>
              <MenuItem Header="Date modified" IsCheckable="True" IsChecked="{Binding Columns.Modified}" Click="ColumnMenu_Click"/>
              <MenuItem Header="Date created" IsCheckable="True" IsChecked="{Binding Columns.Created}" Click="ColumnMenu_Click"/>
              <MenuItem Header="Attributes" IsCheckable="True" IsChecked="{Binding Columns.Attributes}" Click="ColumnMenu_Click"/>
              <Separator/>
              <MenuItem Header="Status bar" IsCheckable="True" IsChecked="{Binding StatusBarVisible}"/>
            </MenuItem>
            <MenuItem Header="_Search">
              <MenuItem Header="Match case" IsCheckable="True" IsChecked="{Binding OptCase}" InputGestureText="Ctrl+I"/>
              <MenuItem Header="Match whole words" IsCheckable="True" IsChecked="{Binding OptWholeWord}" InputGestureText="Ctrl+B"/>
              <MenuItem Header="Match path" IsCheckable="True" IsChecked="{Binding OptPath}" InputGestureText="Ctrl+U"/>
              <MenuItem Header="Match diacritics" IsCheckable="True" IsChecked="{Binding OptDiacritics}" InputGestureText="Ctrl+M"/>
              <Separator/>
              <MenuItem Header="Enable regex" IsCheckable="True" IsChecked="{Binding OptRegex}" InputGestureText="Ctrl+R"/>
              <MenuItem Header="Search file contents" IsCheckable="True" IsChecked="{Binding ContentSearchEnabled}"/>
              <MenuItem Header="New tab" Command="{Binding NewTabCommand}"/>
              <Separator/>
              <MenuItem Header="Everything" Click="FilterMenu_Click" Tag="0"/>
              <MenuItem Header="Audio" Click="FilterMenu_Click" Tag="1"/>
              <MenuItem Header="Compressed" Click="FilterMenu_Click" Tag="2"/>
              <MenuItem Header="Document" Click="FilterMenu_Click" Tag="3"/>
              <MenuItem Header="Executable" Click="FilterMenu_Click" Tag="4"/>
              <MenuItem Header="Folder" Click="FilterMenu_Click" Tag="5"/>
              <MenuItem Header="Picture" Click="FilterMenu_Click" Tag="6"/>
              <MenuItem Header="Video" Click="FilterMenu_Click" Tag="7"/>
            </MenuItem>
            <MenuItem Header="_Bookmarks" Name="BookmarksMenu" SubmenuOpened="BookmarksMenu_Opened">
              <MenuItem Header="Add to bookmarks" InputGestureText="Ctrl+D" Command="{Binding AddBookmarkCommand}"/>
              <MenuItem Header="Remove this bookmark" Command="{Binding RemoveBookmarkCommand}"/>
            </MenuItem>
            <MenuItem Header="_History" Name="HistoryMenu" SubmenuOpened="HistoryMenu_Opened">
              <MenuItem Header="Clear history" Command="{Binding ClearHistoryCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools">
              <MenuItem Header="Rebuild index" Command="{Binding RebuildCommand}"/>
              <MenuItem Header="Run as administrator…" Command="{Binding RunAsAdminCommand}"/>
              <Separator/>
              <MenuItem Header="Prefer NTFS file-table index" IsCheckable="True" IsChecked="{Binding PreferNtfs}"/>
              <MenuItem Header="Index USB / removable drives" IsCheckable="True" IsChecked="{Binding IndexRemovable}"/>
              <MenuItem Header="Index network drives" IsCheckable="True" IsChecked="{Binding IndexNetwork}"/>
              <Separator/>
              <MenuItem Header="Start with Windows" IsCheckable="True" IsChecked="{Binding StartWithWindows}"/>
              <MenuItem Header="Close to tray" IsCheckable="True" IsChecked="{Binding CloseToTray}"/>
              <MenuItem Header="Global hotkey (Ctrl+Alt+Space)" IsCheckable="True" IsChecked="{Binding HotkeyEnabled}"/>
            </MenuItem>
            <MenuItem Header="_Help">
              <MenuItem Header="Search syntax" Command="{Binding OpenHelpCommand}"/>
              <MenuItem Header="About QuickFind" Command="{Binding OpenAboutCommand}"/>
            </MenuItem>
          </Menu>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom"
            Visibility="{Binding StatusBarVisible, Converter={StaticResource BoolVis}}"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
            Height="34" Padding="20,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusLeft}"
                   Foreground="{DynamicResource DimBrush}" FontSize="12.5"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="{Binding IsIndexing, Converter={StaticResource BoolVis}}">
            <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                     Fill="{DynamicResource AccentBrush}">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsIndexing}" Value="True">
                      <DataTrigger.EnterActions>
                        <BeginStoryboard>
                          <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.35" Duration="0:0:1.1" AutoReverse="True"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </DataTrigger.EnterActions>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding IndexPathLabel}" Foreground="{DynamicResource DimBrush}"
                       FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Border Width="84" Height="5" CornerRadius="3" Background="{DynamicResource LineBrush}"
                    VerticalAlignment="Center" Margin="0,0,10,0" ClipToBounds="True">
              <Border HorizontalAlignment="Left" Height="5" CornerRadius="3"
                      Background="{DynamicResource AccentBrush}"
                      Width="{Binding IndexProgressFraction, Converter={StaticResource ProgWidth}, ConverterParameter=84}"/>
            </Border>
            <TextBlock Text="{Binding IndexFoundLabel}" FontWeight="Medium"
                       Foreground="{DynamicResource TextBrush}" FontSize="12.5"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="{Binding StatusRight}"
                     Foreground="{DynamicResource DimBrush}" FontSize="12.5"
                     VerticalAlignment="Center"
                     Visibility="{Binding IsIndexing, Converter={StaticResource InvBoolVis}}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Body: sidebar + main (tabs / search / category+density / results | inspector) -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236" MinWidth="200"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left sidebar -->
      <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
        <DockPanel Margin="12,14,12,12">
          <Button DockPanel.Dock="Bottom" Style="{DynamicResource SidebarLink}"
                  HorizontalContentAlignment="Left" Margin="0,10,0,0"
                  Click="IndexSettings_Click" ToolTip="Index settings"
                  ContextMenu="{StaticResource IndexSettingsMenu}">
            <DockPanel>
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <TextBlock Text="Index settings" VerticalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </DockPanel>
          </Button>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="Locations" FontSize="12.5" FontWeight="SemiBold"
                         FontFamily="{DynamicResource UiFont}"
                         Foreground="{DynamicResource DimBrush}" Margin="10,0,0,6"/>
              <ItemsControl ItemsSource="{Binding Locations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ToggleButton Style="{DynamicResource NavRow}"
                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  Command="{Binding DataContext.SelectLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Width="18"
                                   Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}"
                                   FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource MonoFont}"
                                   Opacity="0.8"
                                   Foreground="{DynamicResource DimBrush}"/>
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                      </DockPanel>
                    </ToggleButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="Saved searches" FontSize="12.5" FontWeight="SemiBold"
                         FontFamily="{DynamicResource UiFont}"
                         Foreground="{DynamicResource DimBrush}" Margin="10,18,0,6"/>
              <ItemsControl ItemsSource="{Binding Bookmarks}"
                            Visibility="{Binding HasBookmarks, Converter={StaticResource BoolVis}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{DynamicResource SidebarLink}"
                            Command="{Binding DataContext.ApplyBookmarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#x2606;" Width="18" Margin="0,0,8,0"
                                   VerticalAlignment="Center" FontSize="13"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Bookmark a search with the star in the search bar."
                         Foreground="{DynamicResource DimBrush}" FontSize="11.5"
                         Margin="10,2,8,0" TextWrapping="Wrap" Opacity="0.85"
                         Visibility="{Binding HasBookmarks, Converter={StaticResource InvBoolVis}}"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Main column -->
      <DockPanel Grid.Column="1" Margin="8,16,20,16">

        <!-- 1) Tabs row: tabs + '+' on the left, Inspector toggle on the right -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="True">
          <ToggleButton DockPanel.Dock="Right"
                        Style="{DynamicResource InspectorToggle}"
                        ToolTip="Show or hide inspector"
                        IsChecked="{Binding ShowPreview}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"/>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
              <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ToggleButton Style="{DynamicResource TabPill}"
                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                        <Button Content="&#x00D7;" Padding="4,0" Margin="8,0,0,0"
                                Background="Transparent" BorderThickness="0"
                                FontSize="14"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding DataContext.Tabs.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource GtOneVis}}"/>
                      </StackPanel>
                    </ToggleButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Style="{DynamicResource IconButton}" Content="+" FontSize="16"
                      ToolTip="New tab" Command="{Binding NewTabCommand}" Margin="4,0,0,0"
                      VerticalAlignment="Center"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>

        <!-- Search card: always reserve 4px outer ring (transparent idle, accent-soft when focused) so layout never shifts -->
        <Border DockPanel.Dock="Top" x:Name="SearchHostOuter"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="4"
                CornerRadius="20"
                Margin="0,0,0,8"
                Padding="0"
                Effect="{DynamicResource SearchCardShadow}"
                IsKeyboardFocusWithinChanged="SearchHost_IsKeyboardFocusWithinChanged">
          <Border x:Name="SearchHost" Style="{DynamicResource SearchCard}">
            <Grid x:Name="SearchHostContent" SizeChanged="SearchHost_SizeChanged">
            <DockPanel>
              <!-- .refine -->
              <Border DockPanel.Dock="Bottom"
                      Background="{DynamicResource Panel2Brush}"
                      BorderBrush="{DynamicResource Line2Brush}"
                      BorderThickness="0,1,0,0"
                      CornerRadius="0,0,15,15"
                      Padding="20,10">
                <DockPanel>
                  <Button DockPanel.Dock="Right"
                          Style="{DynamicResource LinkButton}"
                          Content="Clear filters"
                          Command="{Binding ClearRefineCommand}"
                          VerticalAlignment="Center"
                          Visibility="{Binding HasRefineFilters, Converter={StaticResource BoolVis}}"/>
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="Size" FontSize="12.5" FontWeight="SemiBold"
                                 FontFamily="{DynamicResource UiFont}"
                                 Foreground="{DynamicResource DimBrush}"
                                 VerticalAlignment="Center" Margin="0,0,2,0"/>
                      <ToggleButton Style="{DynamicResource ChipToggle}" Content="&gt; 10 MB" ToolTip="size:&gt;10mb"
                                    IsChecked="{Binding SizeChip10}"/>
                      <ToggleButton Style="{DynamicResource ChipToggle}" Content="&gt; 100 MB" ToolTip="size:&gt;100mb"
                                    IsChecked="{Binding SizeChip100}"/>
                      <ToggleButton Style="{DynamicResource ChipToggle}" Content="&gt; 1 GB" ToolTip="size:&gt;1gb"
                                    IsChecked="{Binding SizeChip1g}" Margin="0"/>
                      <Border Width="1" Height="20" Background="{DynamicResource LineBrush}"
                              Margin="8,0" VerticalAlignment="Center"/>
                      <TextBlock Text="Modified" FontSize="12.5" FontWeight="SemiBold"
                                 FontFamily="{DynamicResource UiFont}"
                                 Foreground="{DynamicResource DimBrush}"
                                 VerticalAlignment="Center" Margin="0,0,2,0"/>
                      <ToggleButton Style="{DynamicResource ChipToggle}" Content="Today" ToolTip="dm:today"
                                    IsChecked="{Binding DateChipToday}"/>
                      <ToggleButton Style="{DynamicResource ChipToggle}" Content="This week" ToolTip="dm:thisweek"
                                    IsChecked="{Binding DateChipWeek}"/>
                      <ToggleButton Style="{DynamicResource ChipToggle}" Content="This month" ToolTip="dm:thismonth"
                                    IsChecked="{Binding DateChipMonth}" Margin="0"/>
                    </StackPanel>
                  </ScrollViewer>
                </DockPanel>
              </Border>

              <!-- .search-row — padding: 6px 10px 6px 20px; min-height:60px; input border:0 -->
              <Grid MinHeight="60" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                           FontSize="18" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="20,6,10,6"/>
                <Grid Grid.Column="1" Margin="0,6,10,6" MinHeight="44" VerticalAlignment="Center">
                  <TextBlock Text="Search files and folders"
                             Foreground="{DynamicResource DimBrush}"
                             FontSize="18" VerticalAlignment="Center"
                             FontFamily="{DynamicResource UiFont}"
                             IsHitTestVisible="False"
                             Visibility="{Binding HasQuery, Converter={StaticResource InvBoolVis}}"/>
                  <TextBox x:Name="SearchBox"
                           Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                           Background="Transparent" BorderThickness="0"
                           FontSize="18" Padding="0" Height="44"
                           FontFamily="{DynamicResource UiFont}"
                           Foreground="{DynamicResource TextBrush}"
                           CaretBrush="{DynamicResource AccentBrush}"
                           VerticalContentAlignment="Center"
                           GotKeyboardFocus="SearchBox_GotKeyboardFocus"/>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,10,6">
                  <Button Style="{DynamicResource IconButton}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                          ToolTip="Clear search"
                          Focusable="False"
                          Command="{Binding ClearQueryCommand}"
                          Visibility="{Binding HasQuery, Converter={StaticResource BoolVis}}"/>
                  <Button Style="{DynamicResource IconButtonMd}" Content="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                          ToolTip="Bookmark this search (Ctrl+D)"
                          Focusable="False"
                          Command="{Binding AddBookmarkCommand}" Margin="0,0,4,0"/>
                  <TextBlock Text="{Binding MatchCountLabel}"
                             Foreground="{DynamicResource DimBrush}"
                             FontSize="13" VerticalAlignment="Center"
                             FontFamily="{DynamicResource UiFont}"
                             MinWidth="110" TextAlignment="Right"
                             Padding="4,0" Margin="0,0,4,0"/>
                  <!-- .toggle-group -->
                  <Border x:Name="OptionsHost" Style="{DynamicResource ToggleGroupHost}">
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton Style="{DynamicResource OptionToggle}" Content="Aa"
                                    ToolTip="Match case (Ctrl+I)" IsChecked="{Binding OptCase}"/>
                      <ToggleButton Style="{DynamicResource OptionToggle}" Content="Word"
                                    ToolTip="Whole words (Ctrl+B)" IsChecked="{Binding OptWholeWord}"/>
                      <ToggleButton Style="{DynamicResource OptionToggle}" Content="Path"
                                    ToolTip="Match path (Ctrl+U)" IsChecked="{Binding OptPath}"/>
                      <ToggleButton Style="{DynamicResource OptionToggle}" Content="é"
                                    ToolTip="Diacritics (Ctrl+M)" IsChecked="{Binding OptDiacritics}"/>
                      <ToggleButton Style="{DynamicResource OptionToggle}" Content=".*"
                                    ToolTip="Regex (Ctrl+R)" IsChecked="{Binding OptRegex}" Margin="0"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </DockPanel>
            </Grid>
          </Border>
        </Border>

        <!-- 3) Category pills + Density segmented -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="True">
          <Border DockPanel.Dock="Right" Style="{DynamicResource SegmentedHost}" Margin="12,0,0,0">
            <StackPanel Orientation="Horizontal">
              <ToggleButton Style="{DynamicResource DensityToggle}"
                            ToolTip="Comfortable rows"
                            IsChecked="{Binding ComfortableRows, Mode=OneWay}"
                            Command="{Binding SetDensityCommand}" CommandParameter="comfy">
                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
              </ToggleButton>
              <ToggleButton Style="{DynamicResource DensityToggle}"
                            ToolTip="Compact rows"
                            IsChecked="{Binding CompactRows, Mode=OneWay}"
                            Command="{Binding SetDensityCommand}" CommandParameter="compact">
                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
              </ToggleButton>
            </StackPanel>
          </Border>

          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Border Style="{DynamicResource SegmentedHost}">
              <ItemsControl ItemsSource="{Binding FilterPills}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ToggleButton Style="{DynamicResource FilterPill}"
                                  Content="{Binding Label}"
                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Index}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </ScrollViewer>
        </DockPanel>

        <!-- 4) Results card + Inspector card -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Results card -->
          <Border Grid.Column="0"
                  Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  CornerRadius="16" ClipToBounds="True">
            <Grid>
              <DataGrid x:Name="ResultsGrid"
                        ItemsSource="{Binding Results}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="True"
                        CanUserResizeRows="False"
                        SelectionMode="Extended"
                        SelectionUnit="FullRow"
                        HeadersVisibility="Column"
                        GridLinesVisibility="None"
                        RowHeight="{Binding ResultsRowHeight}"
                        MinWidth="700"
                        BorderThickness="0"
                        Background="Transparent"
                        RowBackground="Transparent"
                        AlternatingRowBackground="Transparent"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        EnableRowVirtualization="True"
                        MouseDoubleClick="ResultsGrid_MouseDoubleClick"
                        PreviewMouseLeftButtonDown="ResultsGrid_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="ResultsGrid_PreviewMouseMove"
                        Sorting="ResultsGrid_Sorting">
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Open" Click="CtxOpen_Click"/>
                    <MenuItem Header="Open path" Click="CtxOpenPath_Click"/>
                    <Separator/>
                    <MenuItem Header="Copy full name" Click="CtxCopyFull_Click"/>
                    <MenuItem Header="Copy name" Click="CtxCopyName_Click"/>
                    <MenuItem Header="Copy path" Click="CtxCopyPath_Click"/>
                    <Separator/>
                    <MenuItem Header="Copy to…" Command="{Binding CopyToCommand}"/>
                    <MenuItem Header="Move to…" Command="{Binding MoveToCommand}"/>
                    <MenuItem Header="Zip selected…" Command="{Binding ZipSelectedCommand}"/>
                    <MenuItem Header="Batch rename…" Command="{Binding BatchRenameCommand}"/>
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Name" Width="340" MinWidth="220" CanUserResize="True" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <!-- DockPanel LastChildFill gives the name a real width; StackPanel/* Grid still collapsed names -->
                        <DockPanel LastChildFill="True" VerticalAlignment="Center"
                                   ToolTip="{Binding Name}">
                          <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16"
                                 Margin="2,0,10,0" VerticalAlignment="Center"
                                 SnapsToDevicePixels="True"
                                 RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                          <views:HighlightTextBlock
                              SourceText="{Binding Name}"
                              Query="{Binding DataContext.Query, RelativeSource={RelativeSource AncestorType=Window}}"
                              MatchCase="{Binding DataContext.OptCase, RelativeSource={RelativeSource AncestorType=Window}}"
                              WholeWord="{Binding DataContext.OptWholeWord, RelativeSource={RelativeSource AncestorType=Window}}"
                              RegexMode="{Binding DataContext.OptRegex, RelativeSource={RelativeSource AncestorType=Window}}"
                              Diacritics="{Binding DataContext.OptDiacritics, RelativeSource={RelativeSource AncestorType=Window}}"
                              Enabled="True"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"
                              Foreground="{DynamicResource TextBrush}"
                              FontFamily="{DynamicResource UiFont}"
                              FontSize="13"
                              TextWrapping="NoWrap"
                              TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Location" Width="*" MinWidth="180" CanUserResize="True" SortMemberPath="Path"
                                          Visibility="{Binding DataContext.Columns.Path, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <views:HighlightTextBlock
                            SourceText="{Binding Path=Path}"
                            Query="{Binding DataContext.Query, RelativeSource={RelativeSource AncestorType=Window}}"
                            MatchCase="{Binding DataContext.OptCase, RelativeSource={RelativeSource AncestorType=Window}}"
                            WholeWord="{Binding DataContext.OptWholeWord, RelativeSource={RelativeSource AncestorType=Window}}"
                            RegexMode="{Binding DataContext.OptRegex, RelativeSource={RelativeSource AncestorType=Window}}"
                            Diacritics="{Binding DataContext.OptDiacritics, RelativeSource={RelativeSource AncestorType=Window}}"
                            Enabled="{Binding DataContext.OptPath, RelativeSource={RelativeSource AncestorType=Window}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            ToolTip="{Binding Path}"
                            Foreground="{DynamicResource DimBrush}"
                            FontFamily="{DynamicResource MonoFont}"
                            FontSize="12"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100" MinWidth="88"
                                      CanUserResize="True"
                                      Visibility="{Binding DataContext.Columns.Size, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextAlignment" Value="Right"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,0,4,0"/>
                        <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="ToolTip" Value="{Binding Size}"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Ext" Binding="{Binding Extension}" Width="64" MinWidth="56"
                                      Visibility="{Binding DataContext.Columns.Extension, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="152" MinWidth="140"
                                      Visibility="{Binding DataContext.Columns.Modified, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="152" MinWidth="140"
                                      Visibility="{Binding DataContext.Columns.Created, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Attr" Binding="{Binding Attributes}" Width="64" MinWidth="56"
                                      Visibility="{Binding DataContext.Columns.Attributes, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
                        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>

              <!-- Empty-state overlay -->
              <Border Background="{DynamicResource PanelBrush}"
                      Visibility="{Binding ShowOverlay, Converter={StaticResource BoolVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                  <Border Width="48" Height="48" CornerRadius="14" Margin="0,0,0,16"
                          Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"/>
                  </Border>
                  <TextBlock Text="{Binding OverlayTitle}" FontSize="20" FontWeight="SemiBold"
                             FontFamily="{DynamicResource UiFont}"
                             Foreground="{DynamicResource TextBrush}" TextAlignment="Center"/>
                  <TextBlock Text="{Binding OverlayMessage}" Margin="0,10,0,14" TextWrapping="Wrap"
                             Foreground="{DynamicResource DimBrush}" TextAlignment="Center" FontSize="13.5"
                             LineHeight="22"/>
                  <Button Style="{DynamicResource ActionButton}"
                          Content="Clear search and filters"
                          HorizontalAlignment="Center"
                          HorizontalContentAlignment="Center"
                          Padding="16,9"
                          Command="{Binding ClearSearchAndFiltersCommand}"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- Inspector card -->
          <Border Grid.Column="1" Width="340" MaxWidth="380" Margin="12,0,0,0"
                  Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  CornerRadius="16"
                  Visibility="{Binding PreviewPaneVisible, Converter={StaticResource BoolVis}}">
            <Grid Margin="18,16">
              <!-- Empty state -->
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch"
                          Visibility="{Binding Preview.HasSelection, Converter={StaticResource InvBoolVis}}">
                <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                           HorizontalAlignment="Center" Margin="0,0,0,12"
                           Foreground="{DynamicResource DimBrush}"/>
                <TextBlock Text="Nothing selected" FontSize="15" FontWeight="SemiBold"
                           FontFamily="{DynamicResource UiFont}"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="Pick a result to see its preview, size, and location."
                           Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource DimBrush}" FontSize="12.5" LineHeight="20"
                           MaxWidth="240"/>
              </StackPanel>

              <!-- Filled state -->
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding Preview.HasSelection, Converter={StaticResource BoolVis}}">
                <StackPanel>
                  <TextBlock Text="{Binding Preview.Name}" FontSize="18" FontWeight="SemiBold"
                             FontFamily="{DynamicResource UiFont}"
                             Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                  <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="999"
                          Padding="10,3" Margin="0,8,0,12" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Preview.KindLabel}"
                               Foreground="{DynamicResource AccentInkBrush}" FontSize="11" FontWeight="SemiBold"/>
                  </Border>

                  <Border Background="{DynamicResource RaisedBrush}" CornerRadius="12" Padding="10"
                          Margin="0,0,0,12" Height="170"
                          Visibility="{Binding Preview.ShowImage, Converter={StaticResource BoolVis}}">
                    <Image Source="{Binding Preview.Image}" Stretch="Uniform"/>
                  </Border>
                  <Border Background="{DynamicResource RaisedBrush}" CornerRadius="12" Padding="12"
                          Margin="0,0,0,12" MaxHeight="170"
                          Visibility="{Binding Preview.ShowText, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding Preview.Text}"
                               FontFamily="{DynamicResource MonoFont}" FontSize="11"
                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                  </Border>
                  <TextBlock Text="{Binding Preview.Note}" Margin="0,0,0,12"
                             Foreground="{DynamicResource DimBrush}"
                             Visibility="{Binding Preview.ShowNote, Converter={StaticResource BoolVis}}"/>

                  <Button Style="{DynamicResource PrimaryActionButton}" Content="Open"
                          HorizontalContentAlignment="Center"
                          Command="{Binding OpenSelectedCommand}"/>
                  <Button Style="{DynamicResource ActionButton}" Content="Show in folder"
                          HorizontalContentAlignment="Center"
                          Command="{Binding OpenPathCommand}"/>
                  <Button Style="{DynamicResource ActionButton}"
                          Content="{Binding CopyPathLabel}"
                          HorizontalContentAlignment="Center"
                          Command="{Binding CopyPathCommand}" Margin="0,0,0,14"/>

                  <ItemsControl ItemsSource="{Binding Preview.Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource Line2Brush}" BorderThickness="0,1,0,0" Padding="0,11">
                          <Grid>
                            <Grid>
                              <Grid.Style>
                                <Style TargetType="Grid">
                                  <Setter Property="Visibility" Value="Visible"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Label}" Value="Location">
                                      <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Grid.Style>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Label}" Foreground="{DynamicResource DimBrush}" FontSize="12.5"/>
                              <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                         TextAlignment="Right" Foreground="{DynamicResource TextBrush}" FontSize="12.5"/>
                            </Grid>
                            <StackPanel>
                              <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Label}" Value="Location">
                                      <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </StackPanel.Style>
                              <TextBlock Text="Location" Foreground="{DynamicResource DimBrush}" FontSize="12.5"/>
                              <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,6,0,0"
                                         FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                         Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>

  <!-- Command palette -->
  <Grid Visibility="{Binding ShowPalette, Converter={StaticResource BoolVis}}" Panel.ZIndex="100">
    <Border Background="#880A0F14" MouseDown="PaletteScrim_MouseDown"/>
    <Border Width="520" MaxHeight="420" VerticalAlignment="Top" Margin="0,120,0,0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
            CornerRadius="14" Padding="14">
      <Border.Effect>
        <DropShadowEffect BlurRadius="36" ShadowDepth="6" Opacity="0.35" Color="#000000"/>
      </Border.Effect>
      <DockPanel>
        <TextBox x:Name="PaletteBox" DockPanel.Dock="Top"
                 Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="16" Padding="8,8" Margin="0,0,0,10"
                 Background="{DynamicResource RaisedBrush}"
                 Foreground="{DynamicResource TextBrush}"
                 BorderThickness="0"
                 CaretBrush="{DynamicResource AccentBrush}"/>
        <ListBox x:Name="PaletteList"
                 ItemsSource="{Binding PaletteResults}"
                 SelectedIndex="{Binding PaletteIndex}"
                 BorderThickness="0" Background="Transparent"
                 MouseDoubleClick="PaletteList_MouseDoubleClick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="4,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}"
                           Foreground="{DynamicResource DimBrush}" FontSize="11" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontSize="13.5"/>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
  </Grid>
  </Border>
</Window>
