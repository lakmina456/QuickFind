<Window x:Class="QuickFind.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, RelativeSource={RelativeSource Self}}"
        Height="180" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="OK" Width="88" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"
              Style="{DynamicResource PrimaryActionButton}"/>
      <Button Content="Cancel" Width="88" IsCancel="True" Click="Cancel_Click"
              Style="{DynamicResource ActionButton}"/>
    </StackPanel>
    <StackPanel>
      <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10"
                 Foreground="{DynamicResource TextBrush}"/>
      <TextBox x:Name="InputBox" Padding="8,6" FontSize="14"
               Foreground="{DynamicResource TextBrush}"
               Background="{DynamicResource PanelBrush}"
               BorderBrush="{DynamicResource LineBrush}"
               CaretBrush="{DynamicResource AccentBrush}"/>
    </StackPanel>
  </DockPanel>
</Window>
