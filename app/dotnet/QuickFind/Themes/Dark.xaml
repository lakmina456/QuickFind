<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- QuickFind dark — tokens from QuickFind.html [data-theme="dark"] -->
  <Color x:Key="BgColor">#0B0F17</Color>
  <Color x:Key="PanelColor">#121826</Color>
  <Color x:Key="Panel2Color">#171F30</Color>
  <Color x:Key="RaisedColor">#171F30</Color>
  <Color x:Key="SidebarColor">#0B0F17</Color>
  <Color x:Key="TextColor">#E8EDF7</Color>
  <Color x:Key="DimColor">#98A4BA</Color>
  <Color x:Key="AccentColor">#7FA8FF</Color>
  <Color x:Key="AccentFillColor">#6B9BFF</Color>
  <Color x:Key="AccentSoftColor">#1B2A4D</Color>
  <Color x:Key="AccentInkColor">#A9C4FF</Color>
  <Color x:Key="OnAccentColor">#06122B</Color>
  <Color x:Key="SelColor">#19284A</Color>
  <Color x:Key="HoverColor">#161F33</Color>
  <Color x:Key="LineColor">#242E44</Color>
  <Color x:Key="Line2Color">#1D2639</Color>
  <Color x:Key="AltRowColor">#121826</Color>
  <Color x:Key="HlColor">#5C4812</Color>
  <Color x:Key="HlInkColor">#FFE9A8</Color>
  <Color x:Key="Chk1Color">#1B2438</Color>
  <Color x:Key="Chk2Color">#222D45</Color>
  <Color x:Key="DangerColor">#C42B1C</Color>
  <Color x:Key="SuccessColor">#6BBF8A</Color>

  <Color x:Key="BadgePicturesBg">#16403F</Color>
  <Color x:Key="BadgePicturesInk">#8FE3DA</Color>
  <Color x:Key="BadgeDocumentsBg">#252C58</Color>
  <Color x:Key="BadgeDocumentsInk">#B7C0FF</Color>
  <Color x:Key="BadgeAudioBg">#35254F</Color>
  <Color x:Key="BadgeAudioInk">#D5BDF7</Color>
  <Color x:Key="BadgeVideoBg">#4A3017</Color>
  <Color x:Key="BadgeVideoInk">#F6C48E</Color>
  <Color x:Key="BadgeArchivesBg">#3A3528</Color>
  <Color x:Key="BadgeArchivesInk">#D8CBA8</Color>
  <Color x:Key="BadgeAppsBg">#1B3D27</Color>
  <Color x:Key="BadgeAppsInk">#9FE0B3</Color>
  <Color x:Key="BadgeFoldersBg">#4A3E14</Color>
  <Color x:Key="BadgeFoldersInk">#F2D677</Color>
  <Color x:Key="BadgeOtherBg">#2A3445</Color>
  <Color x:Key="BadgeOtherInk">#C3CFDF</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="Panel2Brush" Color="{StaticResource Panel2Color}"/>
  <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="DimBrush" Color="{StaticResource DimColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentFillBrush" Color="{StaticResource AccentFillColor}"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
  <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
  <SolidColorBrush x:Key="SelBrush" Color="{StaticResource SelColor}"/>
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
  <SolidColorBrush x:Key="Line2Brush" Color="{StaticResource Line2Color}"/>
  <SolidColorBrush x:Key="AltRowBrush" Color="{StaticResource AltRowColor}"/>
  <SolidColorBrush x:Key="HlBrush" Color="{StaticResource HlColor}"/>
  <SolidColorBrush x:Key="HlInkBrush" Color="{StaticResource HlInkColor}"/>
  <SolidColorBrush x:Key="Chk1Brush" Color="{StaticResource Chk1Color}"/>
  <SolidColorBrush x:Key="Chk2Brush" Color="{StaticResource Chk2Color}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>

  <SolidColorBrush x:Key="BadgePicturesBgBrush" Color="{StaticResource BadgePicturesBg}"/>
  <SolidColorBrush x:Key="BadgePicturesInkBrush" Color="{StaticResource BadgePicturesInk}"/>
  <SolidColorBrush x:Key="BadgeDocumentsBgBrush" Color="{StaticResource BadgeDocumentsBg}"/>
  <SolidColorBrush x:Key="BadgeDocumentsInkBrush" Color="{StaticResource BadgeDocumentsInk}"/>
  <SolidColorBrush x:Key="BadgeAudioBgBrush" Color="{StaticResource BadgeAudioBg}"/>
  <SolidColorBrush x:Key="BadgeAudioInkBrush" Color="{StaticResource BadgeAudioInk}"/>
  <SolidColorBrush x:Key="BadgeVideoBgBrush" Color="{StaticResource BadgeVideoBg}"/>
  <SolidColorBrush x:Key="BadgeVideoInkBrush" Color="{StaticResource BadgeVideoInk}"/>
  <SolidColorBrush x:Key="BadgeArchivesBgBrush" Color="{StaticResource BadgeArchivesBg}"/>
  <SolidColorBrush x:Key="BadgeArchivesInkBrush" Color="{StaticResource BadgeArchivesInk}"/>
  <SolidColorBrush x:Key="BadgeAppsBgBrush" Color="{StaticResource BadgeAppsBg}"/>
  <SolidColorBrush x:Key="BadgeAppsInkBrush" Color="{StaticResource BadgeAppsInk}"/>
  <SolidColorBrush x:Key="BadgeFoldersBgBrush" Color="{StaticResource BadgeFoldersBg}"/>
  <SolidColorBrush x:Key="BadgeFoldersInkBrush" Color="{StaticResource BadgeFoldersInk}"/>
  <SolidColorBrush x:Key="BadgeOtherBgBrush" Color="{StaticResource BadgeOtherBg}"/>
  <SolidColorBrush x:Key="BadgeOtherInkBrush" Color="{StaticResource BadgeOtherInk}"/>

  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource HoverColor}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource Panel2Color}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource DimColor}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource SelColor}"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource TextColor}"/>
</ResourceDictionary>
